# Bu dosyayı `.env` olarak kopyala ve doldur (gerçek moda geçerken).
# Yüklemek için:  set -a && source .env && set +a

# --- Sunucu / Docker ---
TZ=Europe/Istanbul
# Motor panelin içinde mi çalışsın? Docker Compose kurulumunda panel container'ı
# bunu zaten "false" yapar; elle çalıştırırken true bırak.
RUN_BOT_IN_DASHBOARD=true

# --- Mod ---
DEMO_MODE=true
OFFLINE_SIMULATION=false
USE_TESTNET=false

# --- Binance API (yalnızca DEMO_MODE=false iken gerekir) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- COIN TARAYICI (çok coini ucuza tara, kurulu birkaçı için topla) ---
SCREENER_ENABLED=false           # true yaparsan WATCHLIST taranır
SCREENER_TOP_N=2                 # kaç coin kurula gitsin (maliyeti bu belirler)
SCREENER_INTERVAL_MINUTES=30     # tarama sıklığı (bedava, sık olabilir)
# Alpaca'da işlem görenlerden seç:  python bot.py --list-crypto
# Kurulun veri sağlayıcısı yalnızca şu 11 kriptoyu tanıyor:
# BTC ETH SOL XRP ADA DOGE LTC BCH DOT AVAX LINK
# Listeye başka coin eklersen tarama onu eler (sebebi --screen'de yazar).
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,AVAX/USDT,LINK/USDT,DOT/USDT,LTC/USDT,BCH/USDT,ADA/USDT,XRP/USDT,DOGE/USDT

# --- YAPAY ZEKÂ KURULU (TradingAgents) ---
# Karar motoru: "agents" = kurul karar verir, "manual" = kurul kapalı
DECISION_ENGINE=agents

# LLM sağlayıcısı. OpenRouter / DeepSeek / yerel sunucular OpenAI uyumlu uçtan çalışır.
LLM_PROVIDER=openai
LLM_BACKEND_URL=https://openrouter.ai/api/v1
LLM_DEEP_MODEL=deepseek/deepseek-chat
LLM_QUICK_MODEL=deepseek/deepseek-chat

# Anahtarlardan BİRİ yeterli (öncelik sırası: OpenRouter > OpenAI > DeepSeek)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Ajanların haber/temel verisi (opsiyonel ama önerilir; yoksa o analistler zayıf çalışır)
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Kurul kapasitesi: analistler + tartışma derinliği
# AGENT_ANALYSTS hisse senetleri için, AGENT_ANALYSTS_CRYPTO kripto için.
# Kriptoda "fundamentals" (bilanço/F-K) ve "social" (StockTwits/Reddit) veri
# bulamaz; boş veriyle konuşup tartışmaya gürültü katarlar. Varsayılan olarak
# kapalılar. Hepsini geri istersen:
#   AGENT_ANALYSTS_CRYPTO=market,social,news,fundamentals
AGENT_ANALYSTS=market,social,news,fundamentals
AGENT_ANALYSTS_CRYPTO=market,news
AGENT_DEBATE_ROUNDS=2
AGENT_RISK_ROUNDS=2
AGENT_OUTPUT_LANGUAGE=Turkish

# Kurula verilen ek bağlam: portföy durumumuz, canlı 15 dk teknik verimiz ve
# kripto-yerli göstergeler (funding rate, açık pozisyon, Korku-Açgözlülük).
# Ajanların araçlarında bunlar YOK; prompta biz ekliyoruz.
AGENT_CONTEXT_ENABLED=True
CRYPTO_SIGNALS_ENABLED=True    # dış servis çağrısı; erişilemezse sessizce atlanır
CONTEXT_MAX_AGE_MINUTES=15     # bundan eski fiyat kurula 'anlık' diye gönderilmez

# MALİYET KONTROLÜ — her toplantı onlarca LLM çağrısıdır.
AGENT_INTERVAL_MINUTES=60      # sembol başına toplantı sıklığı (alt sınır 15)
AGENT_MAX_RUNS_PER_DAY=60      # günlük toplam üst sınır (emniyet supabı)
AGENT_RUN_TIMEOUT_SECONDS=2400   # tam kapasite kurul 15-25 dk sürüyor
AGENT_RETRY_MINUTES=10           # geçici hatadan (429) sonra tekrar deneme aralığı
AGENT_CHECKPOINT_ENABLED=True    # yarıda kalan toplantı kaldığı yerden devam etsin

# --- ALPACA PAPER TRADING (emir yürütme) ---
# "auto" = anahtar varsa Alpaca, yoksa dahili sanal defter
EXECUTION_BACKEND=auto
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_PAPER=True                # True -> paper-api.alpaca.markets (sanal para)
ALPACA_POSITION_PCT=0.25         # emir tutarı: hesap öz sermayesinin yüzdesi
ALPACA_MAX_NOTIONAL=5000
ALPACA_MIN_NOTIONAL=10

# --- Hesap / strateji ---
INITIAL_BALANCE=10000
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
RSI_PERIOD=14
RSI_BUY_THRESHOLD=30
RSI_SELL_THRESHOLD=70
EMA_PERIOD=20
TAKE_PROFIT_PCT=0.02
STOP_LOSS_PCT=0.015
POSITION_SIZE_PCT=0.25
# Aynı anda en fazla kaç açık pozisyon? HEM dahili defterde HEM Alpaca'da
# geçerlidir. Limit doluyken kurul "Al" dese bile emir gönderilmez.
# Alpaca paper hesabı 100.000 $ ve emir başına 5.000 $ ise 2 düşük kalır.
MAX_OPEN_POSITIONS=2
LOOP_INTERVAL_SECONDS=30

# --- Caddy ile şifreli panel (deploy/docker-compose.caddy.yml kullanılırsa) ---
# Bu satırları elle doldurmak yerine:  ./deploy/setup-caddy.sh
#
# SITE_ADDRESS=panel.alanadin.com     # sadece IP varsa: https://SUNUCU_IP  ya da  :80
# CADDY_TLS=                          # sadece IP + HTTPS istiyorsan: 'tls internal'
# PANEL_USER=admin
# PANEL_PASSWORD_HASH='$2a$14$...'    # printf '%s\n' 'SIFREN' | docker run --rm -i caddy:2-alpine caddy hash-password
#                                     # TEK TIRNAK şart: bcrypt hash'indeki $ işaretlerini
#                                     # Compose değişken sanıp hash'i bozuyor.
